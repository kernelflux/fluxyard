{
  "name": "@fluxyard/desktop",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node launch.mjs",
    "smoke": "node launch.mjs --smoke",
    "setup": "install-electron --no",
    "package": "node --experimental-strip-types package.mjs"
  },
  "dependencies": {
    "@fluxyard/core": "workspace:*",
    "@fluxyard/runtime-node": "workspace:*",
    "@fluxyard/store-json": "workspace:*"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "electron": "43.0.0",
    "esbuild": "0.27.4"
  }
}
